;========================================================
; 
; Button 1 : P3.2 -> INT0
; Button 2 : P3.0 -> INT4
; Button 3 : P3.6 -> INT2
; Button 4 : P3.3 -> INT1
; Button 5 : P3.7 -> INT3
;
; Active LOW: Button connects input to GND
; Trigger: Falling edge
;========================================================


;========================================================
; SFR DEFINITIONS
;========================================================

P3          DATA    0B0H
IE          DATA    0A8H
TCON        DATA    088H
AUXR2       DATA    08FH


; Interrupt Enable Register IE

EX0         BIT     0A8H
EX1         BIT     0AAH
EA          BIT     0AFH

; Timer Control Register TCON
IT0         BIT     088H
IT1         BIT     08AH



ORG     0000H
LJMP    START

; INT0 - Button 1 - P3.2
            ORG     0003H
            LJMP    INT0_ISR

; INT1 - Button 4 - P3.3
            ORG     0013H
            LJMP    INT1_ISR

; INT2 - Button 3 - P3.6
            ORG     0053H
            LJMP    INT2_ISR

; INT3 - Button 5 - P3.7
            ORG     005BH
            LJMP    INT3_ISR

; INT4 - Button 2 - P3.0
            ORG     0083H
            LJMP    INT4_ISR


;========================================================
; MAIN PROGRAM
;========================================================

ORG     0100H

START:

MOV     SP,#60H

;--------------------------------------------------------
; Configure all five button pins as inputs
; Quasi-bidirectional input: write logic 1
;--------------------------------------------------------
SETB    P3.2
SETB    P3.0
SETB    P3.6
SETB    P3.3
SETB    P3.7

;--------------------------------------------------------
; INT0 and INT1: falling-edge triggered
; IT0 = 1
; IT1 = 1
;--------------------------------------------------------
SETB    IT0
SETB    IT1

;--------------------------------------------------------
; Enable INT0 and INT1
; IE.0 = EX0
; IE.2 = EX1
;--------------------------------------------------------
SETB    EX0
SETB    EX1

;--------------------------------------------------------
; Enable INT2, INT3 and INT4
;
; AUXR2 = 8FH
;
; Bit 6 = EX4
; Bit 5 = EX3
; Bit 4 = EX2
;
; Set bits 4, 5 and 6
;--------------------------------------------------------
MOV     A,AUXR2
ORL     A,#070H
MOV     AUXR2,A

;--------------------------------------------------------
; Global interrupt enable
;--------------------------------------------------------
SETB    EA

;========================================================
; MAIN LOOP
;========================================================
MAIN_LOOP:

NOP
SJMP    MAIN_LOOP


;========================================================
; INTERRUPT SERVICE ROUTINES
;========================================================

;--------------------------------------------------------
; BUTTON 1 - P3.2 - INT0
;--------------------------------------------------------
INT0_ISR:
NOP
RETI

;--------------------------------------------------------
; BUTTON 4 - P3.3 - INT1
;--------------------------------------------------------
INT1_ISR:
NOP
RETI

;--------------------------------------------------------
; BUTTON 3 - P3.6 - INT2
;--------------------------------------------------------
INT2_ISR:
NOP
RETI

;--------------------------------------------------------
; BUTTON 5 - P3.7 - INT3
;--------------------------------------------------------
INT3_ISR:
NOP
RETI

;--------------------------------------------------------
; BUTTON 2 - P3.0 - INT4
;--------------------------------------------------------
INT4_ISR:
NOP
RETI

END
