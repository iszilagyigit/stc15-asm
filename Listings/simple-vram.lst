                      -vram.lst) OBJECT(.\Objects\simple-vram.obj) EP

LOC  OBJ            LINE     SOURCE

                       1     
                       2     
0000                   3     ORG 0000h
0000 020100            4         LJMP LMATRIX_1388A
                       5             
                       6             
0100                   7     ORG 0100h
                       8             
0100                   9     LMATRIX_1388A:
                      10             ; print the VRAM content to P0.0-8 and P1.0-8
0100 90011C           11             MOV DPTR, #VRAM_DATA
0103 E4               12             CLR A
0104 93               13             MOVC A, @A+DPTR
                      14     
0105 7808             15             MOV R0,#8
0107                  16     PRINT_RAWS:
0107 7908             17             MOV R1,#8
0109                  18     PRINT_COLLS:
0109 C3               19             CLR C ; clear the carry
010A 13               20             RRC A ; rotate right throu carry, bit 0 -> C
010B 4007             21             JC LEDON
010D                  22     CONT:   
010D D9FA             23             DJNZ R1, PRINT_COLLS
010F D8F6             24             DJNZ R0, PRINT_RAWS
0111 020118           25             LJMP MAIN_LOOP
                      26             
0114                  27     LEDON:
0114 00               28             NOP
0115 02010D           29             LJMP CONT
                      30     
                      31     
0118                  32     MAIN_LOOP:
0118 00               33             NOP
0119 020118           34             LJMP MAIN_LOOP
                      35     
                      36     
011C                  37     VRAM_DATA:
011C 01020304         38     DB 01h, 02h, 03h, 04h, 05h, 06h, 07h, 08h
0120 05060708                
                      39        
                      40     END
                                     
                                     
